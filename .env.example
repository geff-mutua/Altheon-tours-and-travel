# Your exact production origin, with no trailing slash.
VITE_SITE_URL=https://altheontourandtravels.com

# Google Analytics 4 Measurement ID (Admin > Data streams > Web).
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# EmailJS (emailjs.com) — used to email booking/contact form submissions
# straight to altheontours@gmail.com with no backend server.
# Dashboard > Email Services for the service ID, Email Templates for the
# template ID, Account > General for the public key.
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxx
